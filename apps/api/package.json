  "dependencies": {
    "@ordo/core": "*",
    "@ordo/db": "*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "wrangler": "4.153.0"
  }
}
