# All values below are local, non-secret development defaults.
# npm run dev loads root .env if present; no .env is needed for the default setup.
API_PORT=4318
ORDO_API_URL=http://127.0.0.1:4318
TRUSTED_ORIGINS=http://127.0.0.1:3318,http://localhost:3318

# Optional DATABASE_URL selects an existing PostgreSQL server.
# If absent, development uses embedded PostgreSQL in .data/ordo.
# DATABASE_URL is a secret: set it privately; never commit a populated value.
# Optional ORDO_DATA_DIR changes the embedded development database directory.
# Production requires DATABASE_URL, explicit TRUSTED_ORIGINS, and HTTPS.

# Optional passwordless delivery. Keep the real key in ignored .env only.
GATEKEEPER_API_KEY=
GATEKEEPER_API_URL=https://api.gatekeeperpro.live/api
# Online audio provider keys are account-owned and entered in Settings, not global env.
# Optional phone HTTPS proxy; use a certificate already trusted by the phone.
ORDO_TLS_KEY=
ORDO_TLS_CERT=
ORDO_HTTPS_PORT=3443

# Local Whisper is the default audio provider; settings are per account.
ORDO_WHISPER_URL=http://127.0.0.1:4316
# Optional paths override the installed Mac defaults. Never enable whisper-server --convert.
# ORDO_WHISPER_BIN points to whisper-server; ORDO_WHISPER_MODEL to model weights.
# ORDO_FFMPEG_PATH points to ffmpeg; decoding uses stdin/stdout, never audio files.
# ORDO_CREDENTIAL_KEY: private 64-character hex encryption key for saved provider keys.
# If absent locally, an owner-only master key is created in .data/secrets/audio-key.
# OTP_HMAC_KEY: private 64-character hex key that hashes sign-in codes.
# If absent locally, an owner-only key is created in .data/secrets/otp-key; production requires it.
# Never commit either key or a real provider API key.
GATEKEEPER_EMAIL_HTML=true
