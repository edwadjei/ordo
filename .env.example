# Root .env is only read by `npm run phone:https`. Names only; never commit real values.
# API settings and secrets for `npm run dev` live in apps/api/.dev.vars
# (copy apps/api/.dev.vars.example; it is created automatically on first run).

# Optional phone HTTPS proxy; use a certificate already trusted by the phone.
ORDO_TLS_KEY=
ORDO_TLS_CERT=
ORDO_HTTPS_PORT=3443
# Local web port the proxy forwards to (Next.js dev). Defaults to 3358.
ORDO_WEB_PORT=3358
