# All values below are local, non-secret development defaults.
# npm run dev loads root .env if present; no .env is needed for the default setup.
API_PORT=4318
ORDO_API_URL=http://127.0.0.1:4318
TRUSTED_ORIGINS=http://127.0.0.1:3318,http://localhost:3318

# Optional DATABASE_URL selects an existing PostgreSQL server.
# If absent, development uses embedded PostgreSQL in .data/ordo.
# DATABASE_URL is a secret: set it privately; never commit a populated value.
# Optional ORDO_DATA_DIR changes the embedded development database directory.
# Production requires DATABASE_URL, explicit TRUSTED_ORIGINS, and HTTPS.

# Optional passwordless delivery. Keep the real key in ignored .env only.
GATEKEEPER_API_KEY=
GATEKEEPER_API_URL=https://api.gatekeeperpro.live/api
# Optional audio transcription; without a configured provider show Coming soon.
OPENAI_API_KEY=
# Optional phone HTTPS proxy; use a certificate already trusted by the phone.
ORDO_TLS_KEY=
ORDO_TLS_CERT=
ORDO_HTTPS_PORT=3443
